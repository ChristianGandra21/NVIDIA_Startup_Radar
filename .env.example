# Supabase (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Scraping
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; AIRadarBot/1.0)"
SCRAPER_CACHE_DIR=.cache/raw_pages
SCRAPER_CONCURRENCY=5

# LLM Extractor Agent (compatível com Ollama, Groq, OpenAI)
# Ollama (default): http://localhost:11434/v1/chat/completions, model=llama3
# Groq:             https://api.groq.com/openai/v1/chat/completions, model=llama3-70b-8192
# OpenAI:           https://api.openai.com/v1/chat/completions, model=gpt-4o-mini
LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama3
# LLM_JSON_MODE=true  # descomente se o provider suportar response_format (ex: OpenAI, Groq)
# LLM_RATE_DELAY=10   # segundos mínimos entre chamadas (default: 10)
